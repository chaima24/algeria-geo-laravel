{
    "name": "chaima24/algeria-geo-laravel",
    "description": "Algerian geography for Laravel: 69 wilayas and 1,541 communes, with optional regions and dairas.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "algeria", "wilaya", "commune", "daira"],
    "authors": [
        {
            "name": "chaima24"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Chaima24\\AlgeriaGeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chaima24\\AlgeriaGeo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chaima24\\AlgeriaGeo\\AlgeriaGeoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
